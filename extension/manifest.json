{
  "manifest_version": 3,
  "name": "Smart Chatbot",
  "version": "0.1.0",
  "description": "Ask questions about the current page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Ask about this page"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
